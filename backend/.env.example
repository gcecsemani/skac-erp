# --- Application ---
APP_NAME=SKAC
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- Database (MySQL) ---
# Preferred: split fields (password may contain @ : / without encoding)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=skac
DB_PASSWORD=skac
DB_NAME=skac
# Or a single URL. Encode special chars in the password (@ → %40)
# DATABASE_URL=mysql+pymysql://skac:skac@127.0.0.1:3306/skac

# --- CORS (comma-separated origins) ---
# Local:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production (must match the HTTPS origin staff open in the browser):
# CORS_ORIGINS=https://erp.yourclinic.com

# --- AI (free-tier friendly; leave blank to use the offline heuristic fallback) ---
# provider: gemini | groq | none
AI_PROVIDER=none
AI_API_KEY=
# Model name for the chosen provider, e.g.:
#   gemini -> gemini-3.6-flash
#   groq   -> llama-3.1-8b-instant
AI_MODEL=gemini-3.6-flash

# --- WhatsApp payment reminders (optional Meta Cloud API) ---
# Leave blank to use click-to-chat wa.me links from the Farmers page.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional approved template for business-initiated reminders (body: farmer name, amount).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
