# Copy to .env.prod on the droplet (never commit .env.prod).
# Generate SECRET_KEY:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Public URL of this server (no trailing slash). Field visits need HTTPS.
PUBLIC_URL=https://YOUR_DOMAIN_OR_DROPLET_IP
CORS_ORIGINS=https://YOUR_DOMAIN_OR_DROPLET_IP

MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_PASSWORD=change-this-skac-password

SECRET_KEY=change-me-to-a-long-random-string

AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gemini-3.6-flash
