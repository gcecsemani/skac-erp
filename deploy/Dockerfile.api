# SKAC backend API image
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# System deps (build tools for bcrypt/cryptography wheels are usually not needed
# with manylinux wheels, but keep libpq-free slim image lean).
COPY backend/requirements.txt ./requirements.txt
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY backend/ ./

EXPOSE 8000

# Wait-for-db + migrate + serve is orchestrated by docker-compose command.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
